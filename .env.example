# ============================================================
# REQUIRED — Bot will NOT start without these
# ============================================================

# Your Telegram Bot token from @BotFather
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# MongoDB connection URI (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Telegram channel ID where files are stored (e.g. -1001234567890)
STORAGE_CHANNEL_ID=-1001234567890

# ============================================================
# OPTIONAL — Defaults shown; override as needed
# ============================================================

# Your Render (or other host) public URL — required for webhook mode
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Comma-separated Telegram user IDs that have admin privileges
ADMIN_IDS=111111111,222222222

# Force-join channel ID or @username (leave blank to disable)
FORCE_CHANNEL_ID=@yourchannel

# Express server port
PORT=3000

# Max file downloads per user per day
DAILY_LIMIT=100

# Number of search results shown per page
RESULTS_PER_PAGE=10

# Max number of saved favorites per user
FAV_LIMIT=50

# ============================================================
# TIMING (all values in milliseconds unless noted)
# ============================================================

# How long before a file sent in private chat is auto-deleted (default: 60s)
PRIVATE_AUTO_DELETE_MS=60000

# How long before a file sent in a group is auto-deleted (default: 30s)
GROUP_AUTO_DELETE_MS=30000

# Cooldown between group searches (default: 10s)
GROUP_COOLDOWN_MS=10000

# How long "no results" messages stay before auto-delete (default: 8s)
NO_RESULT_DELETE_MS=8000

# ============================================================
# MONGODB TTL (values in DAYS — documents auto-expire)
# ============================================================

# Daily-limit records (default: 2 days)
LIMIT_DOC_TTL_DAYS=2

# Member-cache records (default: 7 days)
MEMBER_DOC_TTL_DAYS=7

# Search-cache records (default: 1 day)
SEARCH_CACHE_DOC_TTL_DAYS=1

# ============================================================
# SEARCH & DISPLAY
# ============================================================

# Max inline results shown in group search
GROUP_SEARCH_LIMIT=5

# Minimum word length before fuzzy fallback kicks in
FUZZY_MIN_WORD_LEN=3

# Max suggestions shown when no results found
SUGGESTION_LIMIT=5

# Files shown by /trending
TRENDING_LIMIT=10

# Files shown by /recent
RECENT_LIMIT=10
